// Modelo de datos de Bloom Fitness v1.0.
// Cada iteración añade las entidades de su especificación (ver specs/).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── 000 · Plataforma ──────────────────────────────────────────────────────────

/// Centro deportivo. La v1.0 trabaja con un único centro.
model Center {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  timezone  String   @default("Europe/Madrid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  memberImports MemberImport[]
  exercises     Exercise[]
  templates     WorkoutTemplate[]
  routines      Routine[]
  sessions      TrainingSession[]

  @@map("centers")
}

// ─── 001 · Autenticación y usuarios ────────────────────────────────────────────

enum Role {
  ADMIN
  TRAINER
  CLIENT
}

/// Persona con acceso al sistema. Sin contraseña hasta que activa su cuenta.
model User {
  id                   String            @id @default(uuid()) @db.Uuid
  centerId             String            @db.Uuid
  email                String            @unique
  passwordHash         String?
  firstName            String
  lastName             String
  /// Nombre corto que verá la pantalla de sala.
  alias                String?
  role                 Role
  isActive             Boolean           @default(true)
  lastLoginAt          DateTime?
  /// Proveedor del que se importó ('mock', 'timp'). Null si se dio de alta a mano (spec 002).
  externalSource       String?
  /// Identificador del socio en el proveedor.
  externalId           String?
  /// Fecha en que dejó de aparecer en el proveedor y la importación lo desactivó.
  externalMissingSince DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  center               Center            @relation(fields: [centerId], references: [id])
  refreshTokens        RefreshToken[]
  activationTokens     ActivationToken[]
  memberImports        MemberImport[]
  routines             Routine[]         @relation("ClientRoutines")
  trainedSessions      TrainingSession[] @relation("SessionTrainer")
  attendances          SessionAttendee[]

  @@unique([centerId, externalSource, externalId])
  @@index([centerId, role])
  @@map("users")
}

/// Token de refresco opaco. Solo se guarda su hash SHA-256.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Enlace de un solo uso para fijar la contraseña. Solo se guarda su hash SHA-256.
model ActivationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_tokens")
}

// ─── 002 · Importación de socios ───────────────────────────────────────────────

enum ImportStatus {
  SUCCEEDED
  FAILED
}

/// Registro de cada ejecución de la importación de socios.
model MemberImport {
  id               String       @id @default(uuid()) @db.Uuid
  centerId         String       @db.Uuid
  triggeredById    String?      @db.Uuid
  source           String
  status           ImportStatus
  startedAt        DateTime
  finishedAt       DateTime
  createdCount     Int          @default(0)
  updatedCount     Int          @default(0)
  unchangedCount   Int          @default(0)
  deactivatedCount Int          @default(0)
  errorCount       Int          @default(0)
  /// Lista de { externalId, message }. Se guardan como máximo 100.
  errors           Json         @default("[]")
  failureReason    String?

  center      Center @relation(fields: [centerId], references: [id])
  triggeredBy User?  @relation(fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([centerId, startedAt])
  @@map("member_imports")
}

// ─── 003 · Ejercicios, plantillas y rutinas ────────────────────────────────────

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  CORE
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  FULL_BODY
  CARDIO
}

enum Equipment {
  BODYWEIGHT
  BARBELL
  DUMBBELL
  KETTLEBELL
  MACHINE
  CABLE
  BAND
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Ejercicio del catálogo del centro.
model Exercise {
  id            String      @id @default(uuid()) @db.Uuid
  centerId      String      @db.Uuid
  name          String
  primaryMuscle MuscleGroup
  equipment     Equipment
  difficulty    Difficulty
  instructions  String?
  /// Clave del GIF en el almacenamiento de objetos.
  mediaKey      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  center        Center             @relation(fields: [centerId], references: [id])
  templateItems TemplateExercise[]

  @@unique([centerId, name])
  @@index([centerId, isActive])
  @@map("exercises")
}

/// Plantilla: entrenamiento de un día reutilizable entre clientes.
model WorkoutTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  centerId  String   @db.Uuid
  name      String
  goal      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  center   Center             @relation(fields: [centerId], references: [id])
  items    TemplateExercise[]
  routines RoutineTemplate[]

  @@index([centerId, name])
  @@map("workout_templates")
}

/// Ejercicio dentro de una plantilla, con su posición.
model TemplateExercise {
  id           String   @id @default(uuid()) @db.Uuid
  templateId   String   @db.Uuid
  exerciseId   String   @db.Uuid
  position     Int
  sets         Int
  reps         String
  targetLoadKg Decimal? @db.Decimal(6, 2)
  restSeconds  Int
  notes        String?

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Restrict: un ejercicio usado en una plantilla no se puede borrar, solo desactivar.
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([templateId, position])
  @@index([exerciseId])
  @@map("template_exercises")
}

/// Rutina: plan de un cliente con una secuencia de plantillas. Solo una activa por cliente.
model Routine {
  id        String    @id @default(uuid()) @db.Uuid
  centerId  String    @db.Uuid
  clientId  String    @db.Uuid
  name      String
  goal      String?
  startsOn  DateTime  @db.Date
  endsOn    DateTime? @db.Date
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  center    Center            @relation(fields: [centerId], references: [id])
  client    User              @relation("ClientRoutines", fields: [clientId], references: [id])
  templates RoutineTemplate[]

  @@index([clientId, isActive])
  @@map("routines")
}

/// Plantilla en una posición de la rutina (día A, B, C…). Una plantilla puede repetirse.
model RoutineTemplate {
  routineId  String @db.Uuid
  position   Int
  templateId String @db.Uuid

  routine  Routine         @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// Restrict: una plantilla usada en una rutina no se puede borrar.
  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@id([routineId, position])
  @@index([templateId])
  @@map("routine_templates")
}

// ─── 004 · Sesiones en directo ─────────────────────────────────────────────────

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

/// Sesión de entrenamiento de un grupo pequeño. Se llama así para no confundirla con la sesión de usuario.
model TrainingSession {
  id        String        @id @default(uuid()) @db.Uuid
  centerId  String        @db.Uuid
  trainerId String        @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  status    SessionStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  center    Center            @relation(fields: [centerId], references: [id])
  trainer   User              @relation("SessionTrainer", fields: [trainerId], references: [id])
  attendees SessionAttendee[]

  @@index([centerId, startsAt])
  @@map("training_sessions")
}

/// Cliente apuntado a una sesión.
model SessionAttendee {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  clientId  String @db.Uuid

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  User            @relation(fields: [clientId], references: [id])

  @@unique([sessionId, clientId])
  @@index([clientId])
  @@map("session_attendees")
}
