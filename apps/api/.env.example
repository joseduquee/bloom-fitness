# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000
# Base de datos local levantada con `docker compose up -d` desde la raíz del repo.
DATABASE_URL=postgresql://bloom:bloom@localhost:5432/bloom
# Orígenes permitidos para CORS (separados por comas).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Secreto para firmar los tokens de acceso (mínimo 32 caracteres). Se deja vacío a propósito:
# genera uno propio y pégalo aquí. Nunca se versiona un valor real.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
WEB_URL=http://localhost:5173
# Proveedor de socios para la importación: mock (datos simulados) o timp.
MEMBERS_PROVIDER=mock
MOCK_MEMBERS_COUNT=30
# Solo si MEMBERS_PROVIDER=timp. La clave nunca se versiona.
TIMP_API_URL=
TIMP_API_KEY=
# GIF de los ejercicios: carpeta local y URL pública desde la que se sirven.
MEDIA_DIR=uploads
MEDIA_PUBLIC_URL=http://localhost:3000/media
# Asistentes máximos por sesión.
SESSION_MAX_ATTENDEES=4
