{
  "name": "@bloom/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST y canal en tiempo real de Bloom Fitness (NestJS)",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "dependencies": {
    "@bloom/shared": "workspace:*",
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/swagger": "^12.1.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.17",
    "@nestjs/testing": "^12.6.3",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "dotenv": "^18.0.10",
    "dotenv-cli": "^11.1.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
